{#- The colon that closes the declaration, then whatever labels it carries,
    then a link to the source. Reads as `class CharArray: dataclass`. -#}

<span class="doc doc-declaration-colon">:</span>
{% if config.show_labels and labels %}
  <span class="doc doc-labels">
    {% for label in labels|sort %}
      <span class="doc doc-label doc-label-{{ label }}"><code>{{ label }}</code></span>
    {% endfor %}
  </span>
{% endif %}
{% if obj and obj.source_link %}
  <span class="doc doc-labels doc-label-source">
    <a  href="{{ obj.source_link }}"
        target="_blank"
        style="text-decoration: none;"
        title="View Source on GitHub">source</a>
  </span>
{% endif %}
